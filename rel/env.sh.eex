#!/bin/sh

export ECTO_IPV6="false"
export RELEASE_DISTRIBUTION="name"

# The node name. A hosting platform can set SERVICE_NAME and SERVICE_ID. Kubernetes passes the
# pod IP as POD_IP (see deploy/kubernetes/server.yaml). Otherwise the node uses the loopback
# address, which works for a single node.
if [ -n "$SERVICE_NAME" ] && [ -n "$SERVICE_ID" ]; then
  export RELEASE_NODE="$SERVICE_NAME@$SERVICE_ID"
else
  export RELEASE_NODE="${RELEASE_NODE:-opamp_server@${POD_IP:-127.0.0.1}}"
fi
